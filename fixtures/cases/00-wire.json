    "module": "blyg/item",
    "requirements": ["R13.1-1"],
    "issue": "SUK-140",
    "check": "schema",
    "schema": "item",
    "input": {
      "blyg": "0.3",
      "id": "1jt332depwffcsyfz9txf8c9r9",
      "kind": "fragment",
      "origin": "https://example.com/blyg/",
      "created": "2026-07-17T18:00:00Z",
      "updated": "2026-07-17T18:00:00Z",
      "version": 1,
      "content_md": "x",
      "content_html": "<p>x</p>",
      "content_hash": "sha256:2d711642b726b04401627ca9fbac32f5c8530fb1903cc4db02258717921a4881",
      "changelog": [{ "version": 1, "at": "2026-07-17T18:00:00Z", "note": null }],
