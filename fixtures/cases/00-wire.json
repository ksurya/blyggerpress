[
  {
    "id": "wire.manifest.sample",
    "description": "The sample blyg manifest, including the optional blogroll and webmention keys and the informative level/generator/generator_url.",
    "module": "blyg/manifest",
    "requirements": ["R4-3", "R6.1-1", "R3.2-2"],
    "issue": "SUK-138",
    "check": "schema",
    "schema": "manifest",
    "input": { "$file": "fixtures/wire/sample-blyg/blyg.json" },
    "expect": { "valid": true, "emitStrict": true }
  },
  {
