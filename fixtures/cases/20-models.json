    "id": "item.author-opaque",
    "description": "author is a client-asserted opaque object (spec 5.5). Readers MUST accept any object, never reject an item over its contents, and never treat it as an addressable entity.",
    "module": "blyg/item",
    "requirements": ["R5.5-1", "R5.5-3"],
    "issue": "SUK-137",
    "check": "schema",
    "schema": "item",
    "input": {
      "blyg": "0.3",
      "id": "6y1e4khfxxckyd9dhwgrtv2dj4",
      "kind": "fragment",
      "origin": "https://example.com/blyg/",
      "page": "f/6y1e4khfxxckyd9dhwgrtv2dj4/",
      "author": {
        "name": "Opaque Byline",
        "url": "https://example.com/blyg/",
        "nested": { "anything": [1, 2, 3], "even": { "deeper": true } },
        "weird key with spaces": null
      },
      "created": "2026-07-18T12:00:00Z",
      "updated": "2026-07-18T12:00:00Z",
      "version": 1,
      "content_md": "x",
      "content_html": "<p>x</p>",
      "content_hash": "sha256:2d711642b726b04401627ca9fbac32f5c8530fb1903cc4db02258717921a4881",
      "changelog": [{ "version": 1, "at": "2026-07-18T12:00:00Z", "note": null }]
    },
    "expect": { "valid": true }
  },
