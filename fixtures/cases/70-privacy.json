    "module": "blyg/export",
    "requirements": ["R13.5-1"],
    "issue": "SUK-138",
    "check": "privacy",
    "site": "fixtures/wire/sample-blyg",
    "forbidden": ["retainedPinnedVersion", "observedAt", "discrepancies", "watermark"],
    "store": "fixtures/store/sample-store.json",
