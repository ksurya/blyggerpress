    "store": "fixtures/store/sample-store.json",
    "expectInStore": ["PRIVATE-NOTE-SECRET", "PRIVATE-INTENT", "PRIVATE-INSTRUCTION-SECRET", "DRAFT-ONLY"]
  },
  {
    "id": "store.generated-instructions-private",
