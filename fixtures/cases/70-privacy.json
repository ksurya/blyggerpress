    "requirements": ["R5.7-2"],
    "issue": "SUK-136",
    "check": "privacy",
    "site": "fixtures/wire/sample-blyg",
    "forbidden": ["PRIVATE-INSTRUCTION-SECRET"],
    "store": "fixtures/store/sample-store.json",
    "expectInStore": ["PRIVATE-INSTRUCTION-SECRET"]
  },
  {
    "id": "store.subscription-invisible",
    "description": "There is no protocol follow: subscribing is invisible client-local state, so subscription records and their fields never appear in the publication output.",
    "module": "blyg/store",
    "requirements": ["R11-6"],
    "issue": "SUK-136",
    "check": "privacy",
    "site": "fixtures/wire/sample-blyg",
