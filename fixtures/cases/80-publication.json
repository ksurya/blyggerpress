[
  {
    "id": "publication.sample-blyg",
    "description": "Cross-file invariants of the canonical sample blyg: the required static surface exists and is internally consistent, hashes and pins line up, the feed reflects publish events without re-emitting pins or withheld history, and the archive index has no window.",
    "module": "blyg/export",
    "requirements": [
      "R4-2", "R4-3", "R4-4", "R4-5", "R4-6", "R4-7",
      "R5.1-3", "R5.2-6", "R5.8-3",
      "R6.2-1",
      "R7-1", "R7-2", "R7-3", "R7-4", "R7-6", "R7-7", "R7-8", "R7-10", "R7-11", "R7-13",
      "R8-1", "R8.4-1", "R9-2"
    ],
    "issue": "SUK-138",
    "check": "publication",
    "site": "fixtures/wire/sample-blyg",
    "assert": [
      "manifest-surface-files-exist",
      "manifest-keys-consistent",
      "index-consistent",
      "index-order",
      "index-includes-withdrawn",
      "updated-equals-latest-changelog",
      "hashes-valid",
      "pins-present",
      "no-unpinned-history-route",
      "feed-guid-per-version",
      "feed-link-is-page",
      "feed-entries-equal-publish-events",
      "feed-latest-content",
      "feed-manifest-absolute",
      "withdrawn-single-entry",
      "feed-self-contained",
      "pages-have-alternate"
    ]
  }
]
